[Unit]
Description=NetShield authenticated observe-only management
After=network.target

[Service]
Type=simple
User=netshield
Group=netshield
WorkingDirectory=/var/lib/netshield
ExecStart=/opt/netshield/venv/bin/python -I -m netshield --config /etc/netshield/config.json serve
Restart=on-failure
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/netshield
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
